data/faces/
models/*.pt
!models/action_gru.pt
!models/weapons.pt
*.backup
models/*.onnx
models/*.engine
models/weights/
*.pt
runs/
*.mp4
*.avi

# --- Secrets ---
.env
*.key

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Notebooks ---
.ipynb_checkpoints/
.niti/
